{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Eurobot 2025 Debug (O0)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "bench",
      "inherits": "debug",
      "displayName": "Eurobot 2026 Bench (no match timeout)",
      "binaryDir": "${sourceDir}/build/bench",
      "cacheVariables": {
        "EUROBOT_MATCH_TIMEOUT": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": "debug",
      "displayName": "Eurobot 2025 Release (Os)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mechanism",
      "inherits": "bench",
      "binaryDir": "${sourceDir}/build/mechanism",
      "cacheVariables": {
        "EUROBOT_MECHANISM_ONLY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "bench",
      "configurePreset": "bench"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "mechanism",
      "configurePreset": "mechanism"
    }
  ]
}
