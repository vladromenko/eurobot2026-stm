diff --git a/Core/Lib/Include/lift2.h b/Core/Lib/Include/lift2.h
new file mode 100644
index 0000000..8a754bd
--- /dev/null
+++ b/Core/Lib/Include/lift2.h
@@ -0,0 +1,70 @@
+/**
+  ******************************************************************************
+  * @file    lift2.h
+  * @brief   Safe incremental control for Stepper Output 2 and S1/PWM5, S3/PWM6.
+  ******************************************************************************
+  */
+
+#ifndef __LIFT2_H
+#define __LIFT2_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#include "std_def.h"
+
+#define LIFT2_SERVO_MIN_US             1000U
+#define LIFT2_SERVO_NEUTRAL_US         1500U
+#define LIFT2_SERVO_MAX_US             2000U
+#define LIFT2_SERVO_SLEW_US_PER_TICK   10U
+#define LIFT2_UPDATE_PERIOD_MS         20U
+#define LIFT2_MAX_RELATIVE_STEPS       4000L
+#define LIFT2_MIN_POSITION_STEPS       (-32000L)
+#define LIFT2_MAX_POSITION_STEPS       32000L
+
+enum lift2_result_e {
+  LIFT2_OK = 0,
+  LIFT2_INVALID_ARGUMENT = 1,
+  LIFT2_NOT_ARMED = 2,
+  LIFT2_BUSY = 3,
+  LIFT2_OUT_OF_RANGE = 4
+};
+
+enum lift2_flags_e {
+  LIFT2_FLAG_INITIALIZED = 1U << 0,
+  LIFT2_FLAG_ARMED       = 1U << 1,
+  LIFT2_FLAG_MOVING      = 1U << 2,
+  LIFT2_FLAG_SERVO_1     = 1U << 3,
+  LIFT2_FLAG_SERVO_3     = 1U << 4
+};
+
+struct lift2_state_s {
+  uint8_t flags;
+  int32_t position_steps;
+  uint16_t l6474_status;
+  uint16_t servo1_current_us;
+  uint16_t servo1_target_us;
+  uint16_t servo3_current_us;
+  uint16_t servo3_target_us;
+};
+
+struct lift2_s {
+  void (*Init)(void);
+  void (*Update)(void);
+  enum lift2_result_e (*Arm)(void);
+  enum lift2_result_e (*MoveRelative)(int32_t steps);
+  enum lift2_result_e (*Stop)(void);
+  void (*Disarm)(void);
+  enum lift2_result_e (*SetServoTarget)(uint8_t servo_id, uint16_t pulse_us);
+  enum lift2_result_e (*SetZero)(void);
+  void (*GetState)(struct lift2_state_s *state);
+};
+
+extern const struct lift2_s Lift2;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
