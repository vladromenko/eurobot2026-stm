   Terminal.SendResponse(&terminal_response);
 }
 
+static void SendLift2Response(uint8_t cmd, enum lift2_result_e result)
+{
+  struct lift2_state_s state;
+  struct terminal_response_s response = {0};
+
+  Lift2.GetState(&state);
+  response.cmd = cmd;
+  response.data[0] = (uint8_t)result;
+  response.data[1] = state.flags;
+  Word32_ToByte(&state.position_steps, &response.data[2]);
+  Word16_ToByte(&state.l6474_status, &response.data[6]);
+  Word16_ToByte(&state.servo1_current_us, &response.data[8]);
+  Word16_ToByte(&state.servo1_target_us, &response.data[10]);
+  Word16_ToByte(&state.servo3_current_us, &response.data[12]);
+  Word16_ToByte(&state.servo3_target_us, &response.data[14]);
+  response.data_length = 16;
+  Terminal.SendResponse(&response);
+}
+
+static void Lift2Arm(uint8_t* data, uint8_t data_length)
+{
+  enum lift2_result_e result = LIFT2_INVALID_ARGUMENT;
+  (void)data;
+  if(data_length == 0U)
+    result = Lift2.Arm();
+  SendLift2Response(BOARD_LIFT2_ARM, result);
+}
+
+static void Lift2MoveRelative(uint8_t* data, uint8_t data_length)
+{
+  enum lift2_result_e result = LIFT2_INVALID_ARGUMENT;
+  int32_t steps;
+
+  if(data_length == 4U){
+    ByteTo_Word32(data, &steps);
+    result = Lift2.MoveRelative(steps);
+  }
+  SendLift2Response(BOARD_LIFT2_MOVE_REL, result);
+}
+
+static void Lift2Stop(uint8_t* data, uint8_t data_length)
+{
+  enum lift2_result_e result = LIFT2_INVALID_ARGUMENT;
+  (void)data;
+  if(data_length == 0U)
+    result = Lift2.Stop();
+  SendLift2Response(BOARD_LIFT2_STOP, result);
+}
+
+static void Lift2Disarm(uint8_t* data, uint8_t data_length)
+{
+  enum lift2_result_e result = LIFT2_INVALID_ARGUMENT;
+  (void)data;
+  if(data_length == 0U){
+    Lift2.Disarm();
+    result = LIFT2_OK;
+  }
+  SendLift2Response(BOARD_LIFT2_DISARM, result);
+}
+
+static void Lift2SetServo(uint8_t* data, uint8_t data_length)
+{
+  enum lift2_result_e result = LIFT2_INVALID_ARGUMENT;
+  uint16_t pulse_us;
+
+  if(data_length == 3U){
+    ByteTo_Word16(&data[1], &pulse_us);
+    result = Lift2.SetServoTarget(data[0], pulse_us);
+  }
+  SendLift2Response(BOARD_LIFT2_SET_SERVO, result);
+}
+
+static void Lift2GetState(uint8_t* data, uint8_t data_length)
+{
+  (void)data;
+  SendLift2Response(BOARD_LIFT2_GET_STATE,
+                    (data_length == 0U) ? LIFT2_OK : LIFT2_INVALID_ARGUMENT);
+}
+
+static void Lift2SetZero(uint8_t* data, uint8_t data_length)
+{
+  enum lift2_result_e result = LIFT2_INVALID_ARGUMENT;
+  (void)data;
+  if(data_length == 0U)
+    result = Lift2.SetZero();
+  SendLift2Response(BOARD_LIFT2_SET_ZERO, result);
+}
+
 void (*terminal_cmd_handlers[TERMINAL_CMD_TABLE_SIZE])(uint8_t* data, uint8_t data_length) = {[BOARD_Ping] = Ping,
