diff --git a/Core/OS_Tasks/lift2_task.c b/Core/OS_Tasks/lift2_task.c
new file mode 100644
index 0000000..2861c59
--- /dev/null
+++ b/Core/OS_Tasks/lift2_task.c
@@ -0,0 +1,38 @@
+/**
+  ******************************************************************************
+  * @file    lift2_task.c
+  * @brief   Applies bounded PWM servo motion at a fixed 50 Hz update rate.
+  ******************************************************************************
+  */
+
+#include "os_tasks.h"
+#include "lift2.h"
+
+#define TASK_STACK_SIZE 256
+
+static TaskHandle_t task_handle;
+static StackType_t stack_buffer[TASK_STACK_SIZE];
+static StaticTask_t task_buffer;
+
+static void Task(void *arg)
+{
+  (void)arg;
+  while(1){
+    Lift2.Update();
+    vTaskDelay(pdMS_TO_TICKS(LIFT2_UPDATE_PERIOD_MS));
+  }
+}
+
+static TaskHandle_t GetTaskHandle(void)
+{
+  return task_handle;
+}
+
+static void CreateTask(UBaseType_t uxPriority)
+{
+  task_handle = xTaskCreateStatic(Task, "Lift2Task", TASK_STACK_SIZE,
+                                  NULL, uxPriority, stack_buffer, &task_buffer);
+}
+
+const struct os_task_base_s Lift2Task = {.CreateTask = CreateTask,
+                                         .GetTaskHandle = GetTaskHandle};
diff --git a/STEPPER2_TEST_RU.md b/STEPPER2_TEST_RU.md
new file mode 100644
index 0000000..4da66ca
--- /dev/null
+++ b/STEPPER2_TEST_RU.md
@@ -0,0 +1,40 @@
+# Тестовая прошивка Stepper Output 2
+
+Основа: отдельная тестовая копия исходников ветки `lymunt-2026`; изменения не пушатся в основную ветку.
+Штатная папка и ветка не изменялись.
+
+## Что добавлено
+
+- Stepper Motor 2 из разъёма `Stepper Output 2`.
+- Серва `S1` подключается к `PWM5`, серва `S3` — к `PWM6`.
+- Явное разрешение пошагового мотора: после старта всё отключено.
+- Плавный разгон/торможение за 800 мс, микрошаг 1/16.
+- Консервативный ток 500 мА до уточнения паспортного тока обмотки.
+- Команды относительного шага, остановки, отключения, нуля и состояния.
+- Сервы изменяют импульс постепенно: 10 мкс каждые 20 мс.
+
+## Сборка
+
+```bash
+cd ~/test_stm32_stepper2_lymunt
+cmake --preset bench
+cmake --build --preset bench
+```
+
+Ожидаемый файл для записи:
+
+```text
+~/test_stm32_stepper2_lymunt/build/bench/firmware.hex
+```
+
+## Запись, когда механика будет подключена
+
+```bash
+mkdir -p ~/stm32_backups
+cp ~/contoller2027.hex ~/stm32_backups/contoller2027-before-stepper2-$(date +%Y%m%d_%H%M%S).hex
+cp ~/test_stm32_stepper2_lymunt/build/bench/firmware.hex ~/contoller2027.hex
+cd ~
+./flash_stm32.sh
+```
+
+До этого момента `flash_stm32.sh` не запускать.
