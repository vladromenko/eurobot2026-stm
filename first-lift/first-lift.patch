                                                                                               [BOARD_GET_KEY] = GetKey,
                                                                                               [BOARD_GRIPPER_VERTICAL] = GripperVertical,
                                                                                               [BOARD_ROTATE_WHEEL_ONCE] = RotateWheelOnce,
-                                                                                              [BOARD_GRIPPER_SLIDE] = SlideGripper
+                                                                                              [BOARD_GRIPPER_SLIDE] = SlideGripper,
+                                                                                              [BOARD_LIFT2_ARM] = Lift2Arm,
+                                                                                              [BOARD_LIFT2_MOVE_REL] = Lift2MoveRelative,
+                                                                                              [BOARD_LIFT2_STOP] = Lift2Stop,
+                                                                                              [BOARD_LIFT2_DISARM] = Lift2Disarm,
+                                                                                              [BOARD_LIFT2_SET_SERVO] = Lift2SetServo,
+                                                                                              [BOARD_LIFT2_GET_STATE] = Lift2GetState,
+                                                                                              [BOARD_LIFT2_SET_ZERO] = Lift2SetZero
