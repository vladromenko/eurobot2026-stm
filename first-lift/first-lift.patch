diff --git a/Core/Lib/lift2.c b/Core/Lib/lift2.c
new file mode 100644
index 0000000..b5a9fcc
--- /dev/null
+++ b/Core/Lib/lift2.c
@@ -0,0 +1,231 @@
+/**
+  ******************************************************************************
+  * @file    lift2.c
+  * @brief   Explicitly armed, bounded and ramped Stepper 2 / PWM5 / PWM6 control.
+  ******************************************************************************
+  */
+
+#include "lift2.h"
+#include "stepper.h"
+#include "l6474_drvr.h"
+#include "rc_servo.h"
+
+#include <limits.h>
+#include <string.h>
+
+#define LIFT2_STEPPER                 STEPPER_MOTOR_2
+#define LIFT2_SERVO_1_OUTPUT          RC_SERVO_5
+#define LIFT2_SERVO_3_OUTPUT          RC_SERVO_6
+#define LIFT2_STEPPER_EDGE_DIV        32U
+#define LIFT2_STEPPER_WORKING_DIV     24U
+#define LIFT2_STEPPER_RAMP_MS         800U
+#define LIFT2_STEPPER_CURRENT_MA      500.0f
+
+struct servo_state_s {
+  enum rc_servo_e output;
+  uint16_t current_us;
+  uint16_t target_us;
+  uint8_t enabled;
+};
+
+static uint8_t initialized;
+static uint8_t armed;
+static struct servo_state_s servo1 = {LIFT2_SERVO_1_OUTPUT, 0U, 0U, 0U};
+static struct servo_state_s servo3 = {LIFT2_SERVO_3_OUTPUT, 0U, 0U, 0U};
+
+static struct servo_state_s *ServoById(uint8_t servo_id)
+{
+  if(servo_id == 1U)
+    return &servo1;
+  if(servo_id == 3U)
+    return &servo3;
+  return NULL;
+}
+
+static void ClearServoState(struct servo_state_s *servo)
+{
+  servo->current_us = 0U;
+  servo->target_us = 0U;
+  servo->enabled = 0U;
+}
+
+static void Init(void)
+{
+  initialized = 0U;
+  armed = 0U;
+  ClearServoState(&servo1);
+  ClearServoState(&servo3);
+  RC_Servo.Disable(LIFT2_SERVO_1_OUTPUT);
+  RC_Servo.Disable(LIFT2_SERVO_3_OUTPUT);
+}
+
+static void UpdateOneServo(struct servo_state_s *servo)
+{
+  uint16_t delta;
+
+  if((servo->enabled == 0U) || (servo->current_us == servo->target_us))
+    return;
+
+  if(servo->current_us < servo->target_us){
+    delta = servo->target_us - servo->current_us;
+    servo->current_us += (delta > LIFT2_SERVO_SLEW_US_PER_TICK)
+                           ? LIFT2_SERVO_SLEW_US_PER_TICK : delta;
+  }else{
+    delta = servo->current_us - servo->target_us;
+    servo->current_us -= (delta > LIFT2_SERVO_SLEW_US_PER_TICK)
+                           ? LIFT2_SERVO_SLEW_US_PER_TICK : delta;
+  }
+
+  RC_Servo.SetPulseUs(servo->output, servo->current_us);
+}
+
+static void Update(void)
+{
+  UpdateOneServo(&servo1);
+  UpdateOneServo(&servo3);
+}
+
+static enum lift2_result_e Arm(void)
+{
+  if(initialized == 0U){
+    Stepper.Init(LIFT2_STEPPER);
+    L6474H.SetStepMode(LIFT2_STEPPER, L6474_STEP_MODE_16);
+    L6474H.SetCurrentLimit_mA(LIFT2_STEPPER, LIFT2_STEPPER_CURRENT_MA);
+    Stepper.SetZeroPosisition(LIFT2_STEPPER);
+    initialized = 1U;
+  }
+
+  Stepper.Enable(LIFT2_STEPPER);
+  armed = 1U;
+  return LIFT2_OK;
+}
+
+static enum lift2_result_e MoveRelative(int32_t steps)
+{
+  int32_t present;
+  int32_t target;
+
+  if(armed == 0U)
+    return LIFT2_NOT_ARMED;
+  if(Stepper.IsMoving(LIFT2_STEPPER) != 0U)
+    return LIFT2_BUSY;
+  if((steps == 0) || (steps > LIFT2_MAX_RELATIVE_STEPS) ||
+     (steps < -LIFT2_MAX_RELATIVE_STEPS))
+    return LIFT2_OUT_OF_RANGE;
+
+  present = Stepper.GetPresentPosisition(LIFT2_STEPPER);
+  if(((steps > 0) && (present > INT32_MAX - steps)) ||
+     ((steps < 0) && (present < INT32_MIN - steps)))
+    return LIFT2_OUT_OF_RANGE;
+
+  target = present + steps;
+  if((target < LIFT2_MIN_POSITION_STEPS) ||
+     (target > LIFT2_MAX_POSITION_STEPS))
+    return LIFT2_OUT_OF_RANGE;
+
+  Stepper.StepToPosisition(LIFT2_STEPPER, target,
+                          LIFT2_STEPPER_EDGE_DIV,
+                          LIFT2_STEPPER_WORKING_DIV,
+                          LIFT2_STEPPER_RAMP_MS);
+  return LIFT2_OK;
+}
+
+static enum lift2_result_e Stop(void)
+{
+  if(initialized == 0U)
+    return LIFT2_NOT_ARMED;
+  Stepper.StopMotor(LIFT2_STEPPER);
+  return LIFT2_OK;
+}
+
+static void DisableOneServo(struct servo_state_s *servo)
+{
+  RC_Servo.Disable(servo->output);
+  ClearServoState(servo);
+}
+
+static void Disarm(void)
+{
+  if(initialized != 0U){
+    Stepper.StopMotor(LIFT2_STEPPER);
+    Stepper.Disable(LIFT2_STEPPER);
+  }
+  armed = 0U;
+  DisableOneServo(&servo1);
+  DisableOneServo(&servo3);
+}
+
+static enum lift2_result_e SetServoTarget(uint8_t servo_id, uint16_t pulse_us)
+{
+  struct servo_state_s *servo = ServoById(servo_id);
+
+  if(armed == 0U)
+    return LIFT2_NOT_ARMED;
+  if(servo == NULL)
+    return LIFT2_INVALID_ARGUMENT;
+
+  if(pulse_us == 0U){
+    DisableOneServo(servo);
+    return LIFT2_OK;
+  }
+
+  if((pulse_us < LIFT2_SERVO_MIN_US) ||
+     (pulse_us > LIFT2_SERVO_MAX_US))
+    return LIFT2_OUT_OF_RANGE;
+
+  if(servo->enabled == 0U){
+    servo->current_us = pulse_us;
+    servo->target_us = pulse_us;
+    RC_Servo.SetPulseUs(servo->output, pulse_us);
+    RC_Servo.Enable(servo->output);
+    servo->enabled = 1U;
+  }else{
+    servo->target_us = pulse_us;
+  }
+
+  return LIFT2_OK;
+}
+
+static enum lift2_result_e SetZero(void)
+{
+  if(armed == 0U)
+    return LIFT2_NOT_ARMED;
+  if(Stepper.IsMoving(LIFT2_STEPPER) != 0U)
+    return LIFT2_BUSY;
+  Stepper.SetZeroPosisition(LIFT2_STEPPER);
+  return LIFT2_OK;
+}
+
+static void GetState(struct lift2_state_s *state)
+{
+  memset(state, 0, sizeof(*state));
+  if(initialized != 0U){
+    state->flags |= LIFT2_FLAG_INITIALIZED;
+    state->position_steps = Stepper.GetPresentPosisition(LIFT2_STEPPER);
+    state->l6474_status = (uint16_t)L6474H.GetParam(
+        LIFT2_STEPPER, L6474_STATUS, L6474_STATUS_LENGTH);
+    if(Stepper.IsMoving(LIFT2_STEPPER) != 0U)
+      state->flags |= LIFT2_FLAG_MOVING;
+  }
+  if(armed != 0U)
+    state->flags |= LIFT2_FLAG_ARMED;
+  if(servo1.enabled != 0U)
+    state->flags |= LIFT2_FLAG_SERVO_1;
+  if(servo3.enabled != 0U)
+    state->flags |= LIFT2_FLAG_SERVO_3;
+
+  state->servo1_current_us = servo1.current_us;
+  state->servo1_target_us = servo1.target_us;
+  state->servo3_current_us = servo3.current_us;
+  state->servo3_target_us = servo3.target_us;
+}
+
+const struct lift2_s Lift2 = {.Init = Init,
+                              .Update = Update,
+                              .Arm = Arm,
+                              .MoveRelative = MoveRelative,
+                              .Stop = Stop,
+                              .Disarm = Disarm,
+                              .SetServoTarget = SetServoTarget,
+                              .SetZero = SetZero,
+                              .GetState = GetState};
