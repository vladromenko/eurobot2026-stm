+
+static enum lift2_result_e Arm(void)
+{
+  const uint16_t healthy = L6474_OCD_MASK | L6474_TH_SD_MASK | L6474_UVLO_MASK;
+  PrepareDriver();
+  uint16_t status = L6474H.GetParam(LIFT2_STEPPER, L6474_STATUS, L6474_STATUS_LENGTH);
+  if (status == 0xFFFFU || (status & healthy) != healthy) {
+    armed = 0U;
+    return LIFT2_DRIVER_FAULT;
+  }
   Stepper.Enable(LIFT2_STEPPER);
+  vTaskDelay(pdMS_TO_TICKS(2));
+  status = L6474H.GetParam(LIFT2_STEPPER, L6474_STATUS, L6474_STATUS_LENGTH);
+  if ((status & (healthy | L6474_HiZ_MASK)) != healthy) {
+    Stepper.Disable(LIFT2_STEPPER);
+    armed = 0U;
+    return LIFT2_DRIVER_FAULT;
+  }
   armed = 1U;
   return LIFT2_OK;
 }
