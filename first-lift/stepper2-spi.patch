+/* At 168 MHz, 168 single-cycle NOPs alone take 1 us. The L6474
+   requires 800 ns deselected and 350 ns selected before the clock. */
+static void WaitChipSelect(void)
+{
+    __DSB();
+    for (unsigned i = 0; i < 168U; ++i) {
+        __NOP();
+    }
+}
+
+static inline void SelectDriver(enum l6474h_motor_s motor)
+{
+    if (motor == STEPPER_MOTOR_2) WaitChipSelect();
+    LL_GPIO_ResetOutputPin(spi_ncs_gpio[motor], spi_ncs_pin[motor]);
+    if (motor == STEPPER_MOTOR_2) WaitChipSelect();
+}
