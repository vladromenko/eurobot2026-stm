{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd", 
            "cwd": "${workspaceRoot}",

            // Путь к файлу прошивки из Keil
            "executable": "${workspaceRoot}/build/Main_Board/Main_Board.axf",

            "device": "STM32F407VG",

            "armToolchainPath": "D:/Tools/arm-gnu-toolchain/bin",

            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg" 
            ],

            // === ИСПРАВЛЕНИЕ ===
            // Мы ВКЛЮЧАЕМ использование физического пина Reset (NRST).
            // Это необходимо, когда запущена FreeRTOS и ядро спит.
            "openOCDLaunchCommands": [
                "transport select hla_swd",
                "reset_config none" 
            ],
            // ===================
            
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw", // Включил 'raw', чтобы видеть детали, если снова упадет
            
            // Опционально: Путь к SVD файлу для просмотра регистров (раскомментируйте, если есть файл)
            // "svdFile": "${workspaceRoot}/STM32F407.svd",

            "gdbPath": "D:/Tools/arm-gnu-toolchain/bin/arm-none-eabi-gdb.exe"
        },
        
        {
            "name": "Debug (ST-Link Server)",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/Main_Board/Main_Board.axf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "stlink",
            "device": "STM32F407VG",
            "interface": "swd",
            "armToolchainPath": "D:/Tools/arm-gnu-toolchain/bin",

            // Путь к серверу (Оставьте как есть, если файл существует по этому пути)
            "serverpath": "D:/ST/STM32CubeIDE_1.19.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.stlink-gdb-server.win32_2.2.200.202505060755/tools/bin/ST-LINK_gdbserver.exe",

            // === ИСПРАВЛЕНИЕ ===
            // Параметр -m 2 (Software Reset) может не работать с FreeRTOS. 
            // -m 0 (Connect Under Reset) надежнее.
            "serverArgs": [
                "-m", "0"
            ],

            "stm32cubeprogrammer": "C:/Users/artem/.eide/tools/st_cube_programer/bin",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        }
    ]
}