if(NOT EXISTS "${PROGRAMMER}")
  message(FATAL_ERROR "STM32CubeProgrammer not found; set STM32_PROGRAMMER_CLI to its full path")
endif()
set(_connect -c port=SWD mode=HOTPLUG)
if(SERIAL)
  list(APPEND _connect "sn=${SERIAL}")
endif()
if(ACTION STREQUAL "probe")
  execute_process(COMMAND "${PROGRAMMER}" -l stlink RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "ST-LINK enumeration failed")
  endif()
  # HOTPLUG does not reset or halt the running target. Reads only.
  execute_process(COMMAND "${PROGRAMMER}" ${_connect}
    -r32 0xE0042000 4 -r16 0x1FFF7A22 2 RESULT_VARIABLE _rc)
elseif(ACTION STREQUAL "backup")
  string(TIMESTAMP _stamp "%Y%m%d-%H%M%S" UTC)
  set(_backup "${OUTPUT_DIR}/backup-flash-${_stamp}.bin")
  if(EXISTS "${_backup}")
    message(FATAL_ERROR "Backup already exists: ${_backup}")
  endif()
  execute_process(COMMAND "${PROGRAMMER}" ${_connect} -u 0x08000000 0x100000 "${_backup}" RESULT_VARIABLE _rc)
  if(_rc EQUAL 0)
    file(SIZE "${_backup}" _size)
    if(NOT _size EQUAL 1048576)
      message(FATAL_ERROR "Incomplete backup: ${_size} bytes")
    endif()
    message(STATUS "Flash backup: ${_backup}; protect this file before any write")
  endif()
elseif(ACTION STREQUAL "flash")
  # Explicit target invocation is a WRITE. Never called by the normal build.
  # User must first confirm MCU, backup, bootloader and authorization.
  if(NOT DEFINED FLASH_CONNECT_MODE)
    set(FLASH_CONNECT_MODE NORMAL)
  endif()
  if(FLASH_CONNECT_MODE STREQUAL "NORMAL")
    set(_write_connect -c port=SWD mode=NORMAL reset=SWrst)
  elseif(FLASH_CONNECT_MODE STREQUAL "UR")
    set(_write_connect -c port=SWD mode=UR reset=HWrst)
  else()
    message(FATAL_ERROR "FLASH_CONNECT_MODE must be NORMAL or UR; no connection attempted")
  endif()
  if(SERIAL)
    list(APPEND _write_connect "sn=${SERIAL}")
  endif()
  execute_process(COMMAND "${PROGRAMMER}" ${_write_connect}
    -w "${IMAGE}" -v -rst RESULT_VARIABLE _rc)
elseif(ACTION STREQUAL "verify")
  # Standalone verification reads the programmed BIN range and compares it.
  file(SIZE "${BINARY}" _length)
  set(_readback "${OUTPUT_DIR}/verify-readback.bin")
  execute_process(COMMAND "${PROGRAMMER}" ${_connect} -u 0x08000000 ${_length} "${_readback}" RESULT_VARIABLE _rc)
  if(_rc EQUAL 0)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${BINARY}" "${_readback}" RESULT_VARIABLE _rc)
  endif()
elseif(ACTION STREQUAL "reset")
  execute_process(COMMAND "${PROGRAMMER}" ${_connect} -rst RESULT_VARIABLE _rc)
else()
  message(FATAL_ERROR "Unknown programmer action: ${ACTION}")
endif()
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "STM32CubeProgrammer ${ACTION} failed (${_rc}); do not erase or change RDP")
endif()
