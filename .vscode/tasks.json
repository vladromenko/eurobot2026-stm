{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake --preset debug && cmake --build --preset debug",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "cmake --preset release && cmake --build --preset release",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash Debug",
            "type": "shell",
            "command": "cmake --preset debug && cmake --build --preset debug --target flash",
            "problemMatcher": []
        },
        {
            "label": "Flash Release",
            "type": "shell",
            "command": "cmake --preset release && cmake --build --preset release --target flash",
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "rm -rf build/debug build/release",
            "problemMatcher": []
        }
    ]
}
